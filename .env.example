# --- Banco de dados ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nr1?schema=public"

# --- Autenticação (Auth.js / NextAuth) ---
AUTH_SECRET="gerar-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Armazenamento de mídia (S3 ou compatível: AWS S3, Cloudflare R2, MinIO) ---
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="nr1-gravacoes"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_FORCE_PATH_STYLE="false"

# --- Fila de processamento (Redis / BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Provedor de transcrição + diarização de falantes ---
# Providers suportados: "mock" (desenvolvimento, sem custo) | "assemblyai" | "deepgram"
TRANSCRIPTION_PROVIDER="mock"
ASSEMBLYAI_API_KEY=""
DEEPGRAM_API_KEY=""

# URL pública desta aplicação, usada para montar o webhook de callback do provedor
APP_BASE_URL="http://localhost:3000"
TRANSCRIPTION_WEBHOOK_SECRET="gerar-um-segredo-para-validar-callbacks"
